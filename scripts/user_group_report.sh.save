
dhjackbvacqq```bash
#!/bin/bash

# Linux User & Group Management Report

REPORT_DIR="/srv/linux-user-management/reports"
REPORT_FILE="$REPORT_DIR/user_group_report.txt"

# Check whether the report directory exists
if [[ ! -d "$REPORT_DIR" ]]; then
    echo "Error: Report directory does not exist: $REPORT_DIR"
    exit 1
fi

# Check whether the report directory is writable
if [[ ! -w "$REPORT_DIR" ]]; then
    echo "Error: No write permission for $REPORT_DIR"
    echo "Check the directory ownership and permissions."
    exit 1
fi

# Generate the report
{
    echo "======================================"
    echo " Linux User & Group Management Report"
    echo "======================================"
    echo "Generated on: $(date)"
    echo

    echo "----- Current User -----"
    whoami
    echo

    echo "----- DevOps Group -----"
    getent group devops || echo "devops group not found"
    echo

    echo "----- Developer1 Account -----"
    if id developer1 &>/dev/null; then
        id developer1
        getent passwd developer1
    else
        echo "developer1 user not found"
    fi
    echo

    echo "----- Developer2 Account -----"
    if id developer2 &>/dev/null; then
        id developer2
        getent passwd developer2
    else
        echo "developer2 user not found"
    fi
    echo

    echo "----- Shared Directory Permissions -----"
    ls -ld /srv/linux-user-management
    ls -ld /srv/linux-user-management/logs
    ls -ld /srv/linux-user-management/reports
    ls -ld /srv/linux-user-management/scripts
    echo

    echo "----- Log Files -----"
    ls -l /srv/linux-user-management/logs
    echo

    echo "Report generated successfully."
} > "$REPORT_FILE" 2>&1

if [[ $? -eq 0 ]]; then
    echo "Report saved to: $REPORT_FILE"
else
    echo "Error: Failed to generate the report."
    exit 1
fi
